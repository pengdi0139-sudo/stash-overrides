  type: url-test
  url: http://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
  lazy: true
  proxies:
  - 狮城0.5倍率
  - 新加坡01
  - 新加坡02
  - 新加坡03
  - 新加坡04
  - 新加坡05
  - 新加坡06
  - 新加坡07
  - 新加坡08
  - 新加坡09
  - 新加坡10
  - 新加坡11
  - 新加坡12
  - 新加坡13
  - 新加坡14
  - 新加坡15
  - 新加坡16
  - 新加坡17
  - 新加坡18
- name: 香港测速
  type: url-test
  url: http://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
  lazy: true
  proxies:
  - 香港0.5倍率
  - 香港01
  - 香港02
  - 香港03
  - 香港04
  - 香港05
  - 香港06
  - 香港07
  - 香港08
  - 香港09
  - 香港10
  - 香港11
  - 香港12
  - 香港13
  - 香港14
  - 香港15
  - 香港16
  - 香港17
  - 香港18
  - 香港19
  - 香港20
  - 香港21
  - 香港22
  - 香港23
  - 香港24
  - 香港25
  - 香港26
- name: 台湾测速
  type: url-test
  url: http://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
  lazy: true
  proxies:
  - 台湾0.5倍率
  - 台湾01
  - 台湾02
  - 台湾03
  - 台湾04
  - 台湾05
  - 台湾06
- name: 美国优先
  type: fallback
  url: http://www.gstatic.com/generate_204
  interval: 180
  lazy: true
  proxies:
  - 美国测速
  - 自动切换
- name: 自动切换
  type: fallback
  url: http://www.gstatic.com/generate_204
  interval: 180
  lazy: true
  proxies:
  - 美国测速
  - 日本测速
  - 新加坡测速
  - 香港测速
  - 台湾测速
- name: 代理
  type: select
  proxies:
  - 自动切换
  - 美国优先
  - 美国测速
  - 日本测速
  - 新加坡测速
  - 香港测速
  - 台湾测速
- name: Telegram
  type: select
  proxies:
  - 代理
  - 美国测速
  - 香港测速
- name: YouTube
  type: select
  proxies:
  - 代理
  - 美国测速
  - 香港测速
- name: Netflix
  type: select
  proxies:
  - 代理
  - 美国测速
  - 香港测速
- name: BiliBili
  type: select
  proxies:
  - DIRECT
  - 代理
  - 香港测速
- name: 规则外路由选择
  type: select
  proxies:
  - 代理
  - DIRECT
  - 美国测速
rules:
- DOMAIN-SUFFIX,muse.ai,美国优先
- DOMAIN-SUFFIX,longbridge.com,美国测速
- DOMAIN-SUFFIX,longbridge.hk,美国测速
- DOMAIN-SUFFIX,longbridge.sg,美国测速
- DOMAIN-SUFFIX,longbridge.global,美国测速
- DOMAIN-SUFFIX,longbridge.cloud,美国测速
- DOMAIN-SUFFIX,longbridge.app,美国测速
- DOMAIN-SUFFIX,longbridgeapp.com,美国测速
- DOMAIN-SUFFIX,longbridgehk.com,美国测速
- DOMAIN-SUFFIX,longportapp.com,美国测速
- DOMAIN-SUFFIX,longportapp.cn,美国测速
- DOMAIN-SUFFIX,longport.cn,美国测速
- DOMAIN-SUFFIX,lbkrs.com,美国测速
- DOMAIN-SUFFIX,lbctrl.com,美国测速
- DOMAIN,quote.longbridge.global,美国测速
- DOMAIN,trade.longportapp.com,美国测速
- DOMAIN,openapi.longbridge.com,美国测速
- DOMAIN,openapi-quote.longbridge.com,美国测速
- DOMAIN,openapi-trade.longbridge.com,美国测速
- DOMAIN-SUFFIX,longbridge.cn,DIRECT
