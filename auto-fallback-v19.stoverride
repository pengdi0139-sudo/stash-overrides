proxies:
- name: 手机组网-Tailscale
  type: tailscale
name: 自动切换v19-修复版-测速+长桥全局
desc: v18修复版：select组不再写死全部节点名，改走测速组；订阅更新改名/下架节点也不崩。长桥全部域名走美国测速，muse.ai走美国优先。
proxy-groups: #!replace
- name: 美国测速
  type: url-test
  url: http://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
  lazy: true
  proxies:
  - 美国0.5倍率
  - 美国01
  - 美国02
  - 美国03
  - 美国04
  - 美国05
  - 美国06
  - 美国08
  - 美国09
  - 美国10
  - 美国11
  - 美国12
  - 美国13
  - 美国14
  - 美国15
  - 美国16
  - 美国17
  - 美国18
  - 美国19
  - 美国20
  - 美国21
  - 美国22
- name: 日本测速
  type: url-test
  url: http://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
  lazy: true
  proxies:
  - 日本0.5倍率
  - 日本01
  - 日本02
  - 日本03
  - 日本04
  - 日本05
  - 日本06
  - 日本07
  - 日本08
  - 日本09
  - 日本10
  - 日本11
  - 日本12
  - 日本13
